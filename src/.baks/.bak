/**
 * @file apn_fw_striker_node.cpp
 * @brief Fixed-Wing APN Guidance Striker — ROS2 Offboard Node
 *
 * ─────────────────────────────────────────────────────────────────────────────
 *  Translated directly from FixedwingPositionControl::control_strike() firmware
 *  logic into ROS2 offboard attitude setpoint control.
 *
 *  Control layer: ATTITUDE setpoint  (ocm.attitude = true)
 *  Unlike multicopter which commands velocity/acceleration, fixed-wing guidance
 *  must resolve the NED acceleration command into roll/pitch/thrust angles
 *  because the lift vector — not direct thrust — provides lateral/vertical force.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 *  GUIDANCE LAW  — True Proportional Navigation (TPN)
 * ─────────────────────────────────────────────────────────────────────────────
 *
 *  R       = p_target − p_drone                   LOS vector [NED, m]
 *  V_rel   = v_target − v_drone                   relative velocity [NED, m/s]
 *  λ̂       = R / |R|                              LOS unit vector
 *  v̂       = v_drone / |v_drone|                  flight-path unit vector
 *  Vc      = −(V_rel · λ̂)                         closing speed (+ve = closing)
 *  Ω       = (R × V_rel) / |R|²                   LOS angular rate [rad/s]
 *
 *  TPN:
 *  a_PN    = N · |V_drone| · (Ω × v̂)             True PN — always lateral to v̂
 *  a_aug   = (N/2) · [a_tgt − (a_tgt·v̂)v̂]        Augmented term — stripped along v̂
 *                                                  (matches TPN frame, not λ̂)
 *  a_cmd   = a_PN + a_aug                          [saturated to 2g]
 *
 *  NED → Body projection:
 *      a_body  = R_body_from_ned · a_cmd           via attitude quaternion
 *
 *  Attitude inversion  (split-channel):
 *      roll    = atan2(a_body_horiz_y, G)          horizontal PN only, fixed G denom
 *      pitch   = −Kp·(los_el − fpa)               LOS elevation tracking
 *      yaw     = atan2(v_drone_E, v_drone_N)       follow flight path (no sideslip)
 *
 * ─────────────────────────────────────────────────────────────────────────────
 *  Fix log (vs. original)
 * ─────────────────────────────────────────────────────────────────────────────
 *  FIX-1  target_cb dt — use real inter-message delta, not hardcoded DT=0.02s
 *  FIX-2  augmented term — strip along v̂ (TPN frame), was incorrectly using λ̂
 *  FIX-3  tail-chase recovery — detect Vc<0 divergence and command LOS turn
 *  FIX-4  header comment — updated PN formula to match TPN implementation
 *  FIX-5  pitch FPA — use true airspeed for flight-path angle, not ground speed
 *  FIX-6  accel estimator noise guard — zero a_tgt when target nearly stationary
 *  FIX-7  yaw — follow flight path (v̂), not LOS; avoids sideslip in banked turns
 *  FIX-8  proximity fuse — add t_go lookahead (150 ms) for high-closure-speed pull-up
 *  FIX-9  thrust comment — clarify thrust_body[0] convention and FW_THR_MAX note
 *  FIX-10 KP_PITCH — moved to top-level constants alongside other tuning params
 *
 * ─────────────────────────────────────────────────────────────────────────────
 *  Topics
 * ─────────────────────────────────────────────────────────────────────────────
 *  SUB  /strike_point                           sensor_msgs/NavSatFix
 *  SUB  /fmu/out/vehicle_local_position         px4_msgs/VehicleLocalPosition
 *  SUB  /fmu/out/vehicle_status                 px4_msgs/VehicleStatus
 *  SUB  /fmu/out/vehicle_attitude               px4_msgs/VehicleAttitude
 *  SUB  /fmu/out/airspeed_validated             px4_msgs/AirspeedValidated
 *  PUB  /fmu/in/offboard_control_mode           px4_msgs/OffboardControlMode
 *  PUB  /fmu/in/vehicle_attitude_setpoint       px4_msgs/VehicleAttitudeSetpoint
 *  PUB  /fmu/in/vehicle_command                 px4_msgs/VehicleCommand
 */

#include <rclcpp/rclcpp.hpp>
#include <sensor_msgs/msg/nav_sat_fix.hpp>
#include <px4_msgs/msg/vehicle_local_position.hpp>
#include <px4_msgs/msg/vehicle_status.hpp>
#include <px4_msgs/msg/vehicle_attitude.hpp>
#include <px4_msgs/msg/airspeed_validated.hpp>
#include <px4_msgs/msg/offboard_control_mode.hpp>
#include <px4_msgs/msg/vehicle_attitude_setpoint.hpp>
#include <px4_msgs/msg/vehicle_command.hpp>
#include <px4_msgs/msg/vehicle_command_ack.hpp>
#include <Eigen/Dense>
#include <Eigen/Geometry>
#include <cmath>

using namespace std::chrono_literals;

// ═══════════════════════════════════════════════════════════════════════════
//  Tuning Constants  — mirror of firmware FixedwingAPN_strike.cpp
// ═══════════════════════════════════════════════════════════════════════════

static constexpr double APN_N             = 4.5;               // Navigation constant
static constexpr double MAX_ROLL_RAD      = 55.0 * M_PI / 180.0;  // Hard bank limit
static constexpr double MAX_PITCH_RAD     = 40.0 * M_PI / 180.0;  // Hard pitch limit
static constexpr double APN_THRUST        = 1.0;               // Full throttle on strike
                                                                // NOTE: ensure FW_THR_MAX
                                                                // is not clamped to cruise
                                                                // value in PX4 params
static constexpr double HIT_RADIUS        = 5.0;               // Proximity fuse [m]
static constexpr double TGO_LOOKAHEAD_S   = 0.15;              // FIX-8: t_go pull-up threshold [s]
static constexpr double MAX_LAT_ACCEL     = 2.0 * 9.81;        // 2g lateral saturation
static constexpr double AIRSPEED_MIN      = 5.0;               // Fallback airspeed guard [m/s]
static constexpr double AIRSPEED_FALLBACK = 15.0;              // Fallback if sensor bad [m/s]
static constexpr double G                 = 9.81;              // Gravity [m/s²]
static constexpr double DT                = 0.02;              // Guidance loop period [s]
                                                                // NOT used for target estimator
                                                                // (see FIX-1)
static constexpr double R_EARTH           = 6371000.0;         // Earth radius [m]

// FIX-10: KP_PITCH promoted from buried static constexpr inside accel_ned_to_attitude()
static constexpr double KP_PITCH          = 1.5;               // LOS elevation tracking gain

// IIR LPF — target state estimator
static constexpr double ALPHA_TGT_VEL    = 0.25;
static constexpr double ALPHA_TGT_ACCEL  = 0.35;               // FIX-6: raised from 0.15
                                                                // — less lag on maneuvering tgt

// Target accel noise gate — below this speed, zero the accel estimate (FIX-6)
static constexpr double TGT_VEL_ACCEL_GATE = 0.5;             // [m/s]

// Divergence (tail-chase) recovery: if Vc more negative than this, enter re-acquisition (FIX-3)
static constexpr double VC_DIVERGE_THRESH = -2.0;              // [m/s]

// Offboard priming
static constexpr int    PRIME_COUNT      = 50;
static constexpr int    RETRY_INTERVAL   = 25;

// ═══════════════════════════════════════════════════════════════════════════
//  Helpers
// ═══════════════════════════════════════════════════════════════════════════

inline Eigen::Vector3d lpf3(double alpha,
                            const Eigen::Vector3d& x,
                            const Eigen::Vector3d& x_prev)
{
    return alpha * x + (1.0 - alpha) * x_prev;
}

// ═══════════════════════════════════════════════════════════════════════════
//  APNFixedWingStrikerNode
// ═══════════════════════════════════════════════════════════════════════════
class APNFixedWingStrikerNode : public rclcpp::Node
{
public:
    APNFixedWingStrikerNode()
    : Node("apn_fw_striker_node"),
      has_ref_(false), has_target_(false), target_initialized_(false),
      target_time_valid_(false),                                 // FIX-1
      nav_state_(0), setpoint_counter_(0),
      airspeed_(AIRSPEED_FALLBACK),
      drone_pos_ned_(Eigen::Vector3d::Zero()),
      drone_vel_ned_(Eigen::Vector3d::Zero()),
      att_q_(1.0, 0.0, 0.0, 0.0),            // identity quaternion [w,x,y,z]
      target_pos_ned_(Eigen::Vector3d::Zero()),
      target_vel_ned_(Eigen::Vector3d::Zero()),
      target_accel_ned_(Eigen::Vector3d::Zero()),
      target_pos_prev_(Eigen::Vector3d::Zero()),
      target_vel_prev_(Eigen::Vector3d::Zero())
    {
        // ── QoS profiles ───────────────────────────────────────────────────
        auto sensor_qos = rclcpp::QoS(rclcpp::KeepLast(1))
                            .best_effort()
                            .durability_volatile();

        // ── Subscriptions ──────────────────────────────────────────────────
        target_sub_ = this->create_subscription<sensor_msgs::msg::NavSatFix>(
            "/strike_point", 10,
            std::bind(&APNFixedWingStrikerNode::target_cb, this, std::placeholders::_1));

        local_pos_sub_ = this->create_subscription<px4_msgs::msg::VehicleLocalPosition>(
            "/fmu/out/vehicle_local_position", sensor_qos,
            std::bind(&APNFixedWingStrikerNode::local_pos_cb, this, std::placeholders::_1));

        status_sub_ = this->create_subscription<px4_msgs::msg::VehicleStatus>(
            "/fmu/out/vehicle_status_v1", sensor_qos,
            std::bind(&APNFixedWingStrikerNode::status_cb, this, std::placeholders::_1));

        attitude_sub_ = this->create_subscription<px4_msgs::msg::VehicleAttitude>(
            "/fmu/out/vehicle_attitude", sensor_qos,
            std::bind(&APNFixedWingStrikerNode::attitude_cb, this, std::placeholders::_1));

        airspeed_sub_ = this->create_subscription<px4_msgs::msg::AirspeedValidated>(
            "/fmu/out/airspeed_validated", sensor_qos,
            std::bind(&APNFixedWingStrikerNode::airspeed_cb, this, std::placeholders::_1));

        ack_sub_ = this->create_subscription<px4_msgs::msg::VehicleCommandAck>(
            "/fmu/out/vehicle_command_ack", sensor_qos,
            std::bind(&APNFixedWingStrikerNode::ack_cb, this, std::placeholders::_1));

        // ── Publishers ─────────────────────────────────────────────────────
        cmd_pub_  = this->create_publisher<px4_msgs::msg::VehicleCommand>(
            "/fmu/in/vehicle_command", sensor_qos);
        ocm_pub_  = this->create_publisher<px4_msgs::msg::OffboardControlMode>(
            "/fmu/in/offboard_control_mode", sensor_qos);
        att_sp_pub_ = this->create_publisher<px4_msgs::msg::VehicleAttitudeSetpoint>(
            "/fmu/in/vehicle_attitude_setpoint", sensor_qos);

        // ── 50 Hz timer ────────────────────────────────────────────────────
        timer_ = this->create_wall_timer(
            20ms, std::bind(&APNFixedWingStrikerNode::timer_cb, this));

        RCLCPP_INFO(this->get_logger(),
            "[APN-FW] Node initialised. Awaiting GPS origin and strike point...");
    }

private:
    // ── ROS handles ──────────────────────────────────────────────────────────
    rclcpp::Subscription<sensor_msgs::msg::NavSatFix>::SharedPtr          target_sub_;
    rclcpp::Subscription<px4_msgs::msg::VehicleLocalPosition>::SharedPtr  local_pos_sub_;
    rclcpp::Subscription<px4_msgs::msg::VehicleStatus>::SharedPtr         status_sub_;
    rclcpp::Subscription<px4_msgs::msg::VehicleAttitude>::SharedPtr       attitude_sub_;
    rclcpp::Subscription<px4_msgs::msg::AirspeedValidated>::SharedPtr     airspeed_sub_;
    rclcpp::Subscription<px4_msgs::msg::VehicleCommandAck>::SharedPtr     ack_sub_;

    rclcpp::Publisher<px4_msgs::msg::VehicleCommand>::SharedPtr           cmd_pub_;
    rclcpp::Publisher<px4_msgs::msg::OffboardControlMode>::SharedPtr      ocm_pub_;
    rclcpp::Publisher<px4_msgs::msg::VehicleAttitudeSetpoint>::SharedPtr  att_sp_pub_;

    rclcpp::TimerBase::SharedPtr timer_;

    // ── State ─────────────────────────────────────────────────────────────────
    bool    has_ref_, has_target_, target_initialized_;
    bool    target_time_valid_;                               // FIX-1
    uint8_t nav_state_;
    int     setpoint_counter_;
    double  airspeed_;                    // True airspeed [m/s]

    double ref_lat_, ref_lon_;
    float  ref_alt_;

    Eigen::Vector3d    drone_pos_ned_;
    Eigen::Vector3d    drone_vel_ned_;
    Eigen::Vector4d    att_q_;            // [w, x, y, z]

    Eigen::Vector3d    target_pos_ned_;
    Eigen::Vector3d    target_vel_ned_;   // LPF-filtered target velocity
    Eigen::Vector3d    target_accel_ned_; // LPF-filtered target acceleration
    Eigen::Vector3d    target_pos_prev_;
    Eigen::Vector3d    target_vel_prev_;

    rclcpp::Time       target_last_stamp_;  // FIX-1: tracks real inter-message dt

    // ═════════════════════════════════════════════════════════════════════════
    //  GPS → NED conversion
    // ═════════════════════════════════════════════════════════════════════════
    Eigen::Vector3d gps_to_ned(double lat_deg, double lon_deg, double alt_m) const
    {
        const double lat_r     = lat_deg  * M_PI / 180.0;
        const double lon_r     = lon_deg  * M_PI / 180.0;
        const double ref_lat_r = ref_lat_ * M_PI / 180.0;
        const double ref_lon_r = ref_lon_ * M_PI / 180.0;

        Eigen::Vector3d ned;
        ned.x() =  R_EARTH * (lat_r - ref_lat_r);
        ned.y() =  R_EARTH * std::cos(ref_lat_r) * (lon_r - ref_lon_r);
        ned.z() = -(alt_m - static_cast<double>(ref_alt_));
        return ned;
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  Callbacks
    // ═════════════════════════════════════════════════════════════════════════
    void status_cb(const px4_msgs::msg::VehicleStatus::SharedPtr msg)
    {
        nav_state_ = msg->nav_state;
    }

    void attitude_cb(const px4_msgs::msg::VehicleAttitude::SharedPtr msg)
    {
        att_q_ << msg->q[0], msg->q[1], msg->q[2], msg->q[3];
    }

    void airspeed_cb(const px4_msgs::msg::AirspeedValidated::SharedPtr msg)
    {
        if (msg->true_airspeed_m_s > AIRSPEED_MIN) {
            airspeed_ = msg->true_airspeed_m_s;
        }
        // else: keep previous valid value — sensor dropout guard
    }

    void ack_cb(const px4_msgs::msg::VehicleCommandAck::SharedPtr msg)
    {
        if (msg->command == px4_msgs::msg::VehicleCommand::VEHICLE_CMD_DO_SET_MODE) {
            if (msg->result == px4_msgs::msg::VehicleCommandAck::VEHICLE_CMD_RESULT_ACCEPTED) {
                RCLCPP_INFO_ONCE(this->get_logger(), "[APN-FW] OFFBOARD accepted by PX4.");
            } else {
                RCLCPP_WARN_THROTTLE(this->get_logger(), *this->get_clock(), 2000,
                    "[APN-FW] OFFBOARD rejected — result=%d", msg->result);
            }
        }
    }

    void local_pos_cb(const px4_msgs::msg::VehicleLocalPosition::SharedPtr msg)
    {
        if ((msg->xy_global || msg->ref_timestamp > 0) && !has_ref_) {
            has_ref_ = true;
            ref_lat_ = msg->ref_lat;
            ref_lon_ = msg->ref_lon;
            ref_alt_ = msg->ref_alt;
            RCLCPP_INFO(this->get_logger(),
                "[APN-FW] GPS origin latched → Lat=%.6f  Lon=%.6f  Alt=%.2fm",
                ref_lat_, ref_lon_, ref_alt_);
        }
        drone_pos_ned_ << msg->x,  msg->y,  msg->z;
        drone_vel_ned_ << msg->vx, msg->vy, msg->vz;
    }

    // ─────────────────────────────────────────────────────────────────────────
    //  target_cb — FIX-1: use real inter-message dt for finite differences
    //
    //  The original code divided by DT=0.02s unconditionally, assuming the
    //  publisher runs at exactly 50 Hz.  Any external publisher (operator tool,
    //  vision pipeline, etc.) will run at a different or variable rate, making
    //  the velocity and acceleration estimates wrong by a proportional factor.
    //  We now measure the actual elapsed time between consecutive callbacks.
    // ─────────────────────────────────────────────────────────────────────────
    void target_cb(const sensor_msgs::msg::NavSatFix::SharedPtr msg)
    {
        if (!has_ref_) {
            RCLCPP_WARN_THROTTLE(this->get_logger(), *this->get_clock(), 2000,
                "[APN-FW] GPS origin not ready — ignoring strike point.");
            return;
        }

        const Eigen::Vector3d p_new = gps_to_ned(msg->latitude, msg->longitude, msg->altitude);

        // FIX-1: compute real elapsed time between consecutive strike-point messages
        const rclcpp::Time now = this->get_clock()->now();
        double tgt_dt = DT;  // safe fallback for first sample
        if (target_time_valid_) {
            tgt_dt = std::clamp((now - target_last_stamp_).seconds(), 0.005, 0.5);
            // clamp: 0.005s floor avoids divide-by-zero on duplicate stamps
            //        0.5s  ceil  avoids huge velocity spike after a dropout
        }
        target_last_stamp_ = now;
        target_time_valid_ = true;

        // ── Target kinematic estimator ────────────────────────────────────
        if (target_initialized_) {
            // 1st derivative: position → velocity (using real dt)
            const Eigen::Vector3d raw_vel = (p_new - target_pos_prev_) / tgt_dt;
            target_vel_ned_ = lpf3(ALPHA_TGT_VEL, raw_vel, target_vel_ned_);

            // FIX-6: only estimate acceleration when target is actually moving.
            // Double finite-differencing GPS is O(dt⁻²) noise amplification;
            // for a stationary ground target the result is pure noise.
            if (target_vel_ned_.norm() > TGT_VEL_ACCEL_GATE) {
                const Eigen::Vector3d raw_acc = (target_vel_ned_ - target_vel_prev_) / tgt_dt;
                target_accel_ned_ = lpf3(ALPHA_TGT_ACCEL, raw_acc, target_accel_ned_);
            } else {
                // Target nearly stationary — bleed accel estimate to zero
                target_accel_ned_ = lpf3(ALPHA_TGT_ACCEL,
                                         Eigen::Vector3d::Zero(),
                                         target_accel_ned_);
            }

            target_vel_prev_ = target_vel_ned_;
        } else {
            target_vel_ned_     = Eigen::Vector3d::Zero();
            target_accel_ned_   = Eigen::Vector3d::Zero();
            target_vel_prev_    = Eigen::Vector3d::Zero();
            target_initialized_ = true;
        }

        target_pos_prev_ = p_new;
        target_pos_ned_  = p_new;

        if (!has_target_) {
            has_target_ = true;
            RCLCPP_INFO(this->get_logger(),
                "[APN-FW] Strike point acquired → NED [N=%.2f, E=%.2f, D=%.2f]m",
                target_pos_ned_.x(), target_pos_ned_.y(), target_pos_ned_.z());
        }
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  APN Guidance — NED acceleration command  (True PN + augmentation)
    //
    //  FIX-2: augmented term now strips component along v̂ (flight-path axis)
    //         to match the TPN frame.  The original code stripped along λ̂
    //         (LOS axis), which is only correct for Pure PN.  Under large
    //         heading error the two diverge significantly.
    //
    //  FIX-3: tail-chase / divergence recovery.  When Vc < VC_DIVERGE_THRESH
    //         the drone is flying away from the target.  In that case the PN
    //         term's magnitude (N·V_mag) is still large but in the wrong
    //         direction; we detect this and command a maximum-G turn back
    //         toward the LOS instead.
    // ═════════════════════════════════════════════════════════════════════════
    Eigen::Vector3d compute_apn_accel_ned()   // non-const: RCLCPP_WARN_THROTTLE needs mutable clock
    {
        // ── LOS geometry ─────────────────────────────────────────────────
        const Eigen::Vector3d R_vec  = target_pos_ned_ - drone_pos_ned_;
        double                R_mag  = R_vec.norm();
        if (R_mag < 0.1) R_mag = 0.1;

        const Eigen::Vector3d lambda_hat = R_vec / R_mag;

        // ── Drone flight-path unit vector ─────────────────────────────────
        double V_mag = drone_vel_ned_.norm();
        if (V_mag < 1.0) V_mag = 1.0;
        const Eigen::Vector3d v_hat = drone_vel_ned_ / V_mag;

        // ── Relative kinematics ───────────────────────────────────────────
        const Eigen::Vector3d V_rel = target_vel_ned_ - drone_vel_ned_;
        const double          Vc    = -(V_rel.dot(lambda_hat));

        // FIX-3: tail-chase / divergence recovery ─────────────────────────
        // If the drone is actively flying away from the target (Vc strongly
        // negative) and the heading error exceeds 90°, standard PN produces
        // a command that opposes the required turn.  Instead we command a
        // maximum-G pull toward the LOS until the heading error collapses.
        const double heading_error =
            std::acos(std::clamp(v_hat.dot(lambda_hat), -1.0, 1.0));

        if (Vc < VC_DIVERGE_THRESH && heading_error > M_PI / 2.0) {
            // Re-acquisition: lateral pull toward LOS, perpendicular to flight path
            // Direction: component of λ̂ perpendicular to v̂, normalised
            const Eigen::Vector3d pull_dir =
                (lambda_hat - lambda_hat.dot(v_hat) * v_hat).normalized();
            RCLCPP_WARN_THROTTLE(this->get_logger(), *this->get_clock(), 1000,
                "[APN-FW] Tail-chase detected (Vc=%.1f m/s, HE=%.1f°) — re-acquisition.",
                Vc, heading_error * 180.0 / M_PI);
            return pull_dir * MAX_LAT_ACCEL;
        }

        // ── LOS angular rate ──────────────────────────────────────────────
        const Eigen::Vector3d Omega = R_vec.cross(V_rel) / (R_mag * R_mag);

        // ── True PN term ──────────────────────────────────────────────────
        // Acceleration is Ω × v̂, scaled by N·|V_drone|.
        // Always perpendicular to the flight path — ensures nonzero roll command
        // even at large heading errors (unlike Pure PN which can vanish at 90°).
        const Eigen::Vector3d a_PN = Omega.cross(v_hat) * (APN_N * V_mag);

        // ── Augmented term  (FIX-2) ───────────────────────────────────────
        // Strip the flight-path-parallel component from target acceleration.
        // For TPN, the guidance frame is v̂, so we must strip along v̂ —
        // not along λ̂ as in Pure PN.  Using λ̂ here introduces a projection
        // error proportional to sin(heading_error), reaching 100% at 90°.
        const Eigen::Vector3d a_tgt_perp =
            target_accel_ned_ - target_accel_ned_.dot(v_hat) * v_hat;
        const Eigen::Vector3d a_aug = a_tgt_perp * (APN_N / 2.0);

        // ── Combine + saturate ────────────────────────────────────────────
        Eigen::Vector3d a_cmd = a_PN + a_aug;
        if (a_cmd.norm() > MAX_LAT_ACCEL) {
            a_cmd = a_cmd.normalized() * MAX_LAT_ACCEL;
        }

        return a_cmd;
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  Fixed-Wing Attitude Command  (split-channel guidance)
    //
    //  ROLL  ← horizontal PN only (N-E plane of a_cmd)
    //           Zeros out a_cmd.z before projecting to body-y so vertical
    //           acceleration cannot inflate g_eff and shrink the roll command.
    //           Uses constant G denominator for predictable scaling.
    //
    //  PITCH ← LOS elevation angle tracking  (FIX-5)
    //           FPA computed using true airspeed (TAS) instead of ground speed.
    //           In significant wind, ground speed misrepresents the actual
    //           flight-path angle that the elevator responds to.
    //
    //  YAW   ← follows flight-path vector  (FIX-7)
    //           Original code pointed yaw at the LOS, generating sideslip
    //           during banked turns.  We now align yaw with v_drone so the
    //           fuselage stays coordinated; roll steers the aircraft.
    // ═════════════════════════════════════════════════════════════════════════
    struct AttitudeCmd { double roll, pitch, yaw; };

    AttitudeCmd accel_ned_to_attitude(const Eigen::Vector3d& a_cmd) const
    {
        const Eigen::Vector3d R_vec = target_pos_ned_ - drone_pos_ned_;

        // ── ROLL: horizontal PN → body-lateral ───────────────────────────
        const Eigen::Vector3d    a_horiz{a_cmd(0), a_cmd(1), 0.0};
        const Eigen::Quaterniond q(att_q_(0), att_q_(1), att_q_(2), att_q_(3));
        const Eigen::Matrix3d    R_body_from_ned =
            q.normalized().toRotationMatrix().transpose();
        const Eigen::Vector3d    a_body_horiz = R_body_from_ned * a_horiz;

        const double roll = std::clamp(
            std::atan2(a_body_horiz(1), G),
            -MAX_ROLL_RAD, MAX_ROLL_RAD);

        // ── PITCH: LOS elevation tracking  (FIX-5) ───────────────────────
        // los_el: positive in NED D-axis = target is BELOW drone
        // fpa:    positive in NED D-axis = aircraft descending
        //
        // FIX-5: Use true airspeed for FPA horizontal component instead of
        // horizontal ground speed.  Under headwind/tailwind, ground speed
        // distorts the inferred flight-path angle.  TAS is what the elevator
        // pitch angle actually corresponds to aerodynamically.
        const double R_horiz_mag = std::max(
            std::sqrt(R_vec(0)*R_vec(0) + R_vec(1)*R_vec(1)), 0.1);
        const double los_el = std::atan2(R_vec(2), R_horiz_mag);

        // Horizontal TAS component — guard against near-zero speed
        const double tas_horiz = std::max(airspeed_, AIRSPEED_MIN);
        const double fpa       = std::atan2(drone_vel_ned_(2), tas_horiz);

        // KP_PITCH is now a top-level constant (FIX-10)
        const double pitch = std::clamp(
            -KP_PITCH * (los_el - fpa),
            -MAX_PITCH_RAD, MAX_PITCH_RAD);

        // ── YAW: follow flight path, not LOS  (FIX-7) ────────────────────
        // Pointing yaw at the LOS forces a sideslip angle whenever the drone
        // is in a banked turn (flight path ≠ LOS direction).  Fixed-wing
        // turns are coordinated by roll; yaw should track the velocity vector
        // so the fuselage remains aligned with the flight path.
        //
        // Exception: if ground speed is negligible (e.g. just after launch),
        // fall back to LOS pointing to avoid atan2(0,0) instability.
        const double v_gnd = std::sqrt(
            drone_vel_ned_(0)*drone_vel_ned_(0) +
            drone_vel_ned_(1)*drone_vel_ned_(1));

        const double yaw = (v_gnd > 1.0)
            ? std::atan2(drone_vel_ned_(1), drone_vel_ned_(0))   // flight path
            : std::atan2(R_vec(1), R_vec(0));                    // fallback: LOS

        return {roll, pitch, yaw};
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  50 Hz Timer
    // ═════════════════════════════════════════════════════════════════════════
    void timer_cb()
    {
        if (!has_target_) return;

        const uint64_t ts = this->get_clock()->now().nanoseconds() / 1000;

        // ── Offboard control mode heartbeat — must be ATTITUDE for fixed-wing
        auto ocm         = px4_msgs::msg::OffboardControlMode();
        ocm.timestamp    = ts;
        ocm.position     = false;
        ocm.velocity     = false;
        ocm.acceleration = false;
        ocm.attitude     = true;
        ocm.body_rate    = false;
        ocm_pub_->publish(ocm);

        // ── Offboard mode management ───────────────────────────────────────
        manage_offboard_mode();

        // ── Only run guidance when OFFBOARD is active ──────────────────────
        const bool is_offboard =
            (nav_state_ == px4_msgs::msg::VehicleStatus::NAVIGATION_STATE_OFFBOARD);
        if (!is_offboard) return;

        // ── Geometry ──────────────────────────────────────────────────────
        const Eigen::Vector3d R_vec = target_pos_ned_ - drone_pos_ned_;
        const double          R_mag = R_vec.norm();

        // ── Closing speed for t_go estimate ───────────────────────────────
        const Eigen::Vector3d lambda_hat = R_vec / std::max(R_mag, 0.1);
        const Eigen::Vector3d V_rel      = target_vel_ned_ - drone_vel_ned_;
        const double          Vc         = -(V_rel.dot(lambda_hat));

        // FIX-8: proximity fuse with t_go lookahead ───────────────────────
        // At high closure speeds the reactive 5 m sphere gives only one or
        // zero guidance iterations of warning.  We also trigger when the
        // estimated time-to-go falls below TGO_LOOKAHEAD_S (150 ms default).
        const double t_go = (Vc > 1.0) ? (R_mag / Vc) : 999.0;

        if (R_mag < HIT_RADIUS || t_go < TGO_LOOKAHEAD_S) {
            handle_terminal(ts, R_vec);
            return;
        }

        // ── Guidance: NED acceleration → attitude setpoint ────────────────
        const Eigen::Vector3d a_cmd = compute_apn_accel_ned();
        const AttitudeCmd     att   = accel_ned_to_attitude(a_cmd);

        publish_attitude_setpoint(att.roll, att.pitch, att.yaw, APN_THRUST, ts);

        // ── Diagnostics ───────────────────────────────────────────────────
        log_diagnostics(R_vec, R_mag, Vc, t_go, att);
    }

    // ── Terminal: pull up and cut thrust  (FIX-8: pass R_vec explicitly) ─────
    void handle_terminal(uint64_t ts, const Eigen::Vector3d& R_vec)
    {
        // FIX-7: use flight-path yaw in terminal phase too, consistent with
        // normal guidance.  Fall back to LOS if ground speed is negligible.
        const double v_gnd = std::sqrt(
            drone_vel_ned_(0)*drone_vel_ned_(0) +
            drone_vel_ned_(1)*drone_vel_ned_(1));
        const double yaw = (v_gnd > 1.0)
            ? std::atan2(drone_vel_ned_(1), drone_vel_ned_(0))
            : std::atan2(R_vec(1), R_vec(0));

        publish_attitude_setpoint(0.0, -MAX_PITCH_RAD, yaw, 0.0, ts);

        RCLCPP_INFO_THROTTLE(this->get_logger(), *this->get_clock(), 2000,
            "[APN-FW] ★ TARGET HIT — pull-up + thrust cut.");
    }

    // ── Pack and publish VehicleAttitudeSetpoint ──────────────────────────────
    void publish_attitude_setpoint(double roll, double pitch, double yaw,
                                   double thrust, uint64_t ts)
    {
        const Eigen::Quaterniond q =
            Eigen::AngleAxisd(yaw,   Eigen::Vector3d::UnitZ()) *
            Eigen::AngleAxisd(pitch, Eigen::Vector3d::UnitY()) *
            Eigen::AngleAxisd(roll,  Eigen::Vector3d::UnitX());

        auto sp = px4_msgs::msg::VehicleAttitudeSetpoint();
        sp.timestamp      = ts;
        sp.q_d[0]         = static_cast<float>(q.w());
        sp.q_d[1]         = static_cast<float>(q.x());
        sp.q_d[2]         = static_cast<float>(q.y());
        sp.q_d[3]         = static_cast<float>(q.z());

        // FIX-9: thrust_body[0] is forward (pusher/tractor) throttle normalised
        // to [0,1].  APN_THRUST=1.0 commands full throttle.
        // IMPORTANT: verify FW_THR_MAX in PX4 params is not clamped to a cruise
        // value — it will silently cap the actual throttle below 1.0 if so.
        sp.thrust_body[0] = static_cast<float>(thrust);
        sp.thrust_body[1] = 0.0f;
        sp.thrust_body[2] = 0.0f;
        sp.yaw_sp_move_rate = 0.0f;

        att_sp_pub_->publish(sp);
    }

    // ── OFFBOARD mode management ──────────────────────────────────────────────
    void manage_offboard_mode()
    {
        if (setpoint_counter_ < PRIME_COUNT) {
            ++setpoint_counter_;
            return;
        }

        const bool is_offboard =
            (nav_state_ == px4_msgs::msg::VehicleStatus::NAVIGATION_STATE_OFFBOARD);

        if (!is_offboard) {
            const int ticks = setpoint_counter_ - PRIME_COUNT;
            if (ticks % RETRY_INTERVAL == 0) {
                publish_vehicle_command(
                    px4_msgs::msg::VehicleCommand::VEHICLE_CMD_DO_SET_MODE,
                    1.0f, 6.0f);
                RCLCPP_INFO(this->get_logger(),
                    "[APN-FW] Requesting OFFBOARD mode (nav_state=%d)...", nav_state_);
            }
        }

        ++setpoint_counter_;
    }

    void publish_vehicle_command(uint16_t command,
                                 float param1 = 0.f, float param2 = 0.f)
    {
        auto msg             = px4_msgs::msg::VehicleCommand();
        msg.timestamp        = this->get_clock()->now().nanoseconds() / 1000;
        msg.command          = command;
        msg.param1           = param1;
        msg.param2           = param2;
        msg.target_system    = 1;
        msg.target_component = 1;
        msg.source_system    = 1;
        msg.source_component = 1;
        msg.from_external    = true;
        cmd_pub_->publish(msg);
    }

    // ── Diagnostics  (extended with t_go column) ─────────────────────────────
    void log_diagnostics(const Eigen::Vector3d& R_vec, double R_mag,
                         double Vc, double t_go,
                         const AttitudeCmd& att)
    {
        const Eigen::Vector3d lambda_hat = R_vec / R_mag;
        const Eigen::Vector3d V_rel      = target_vel_ned_ - drone_vel_ned_;
        const double          Vtan       =
            (V_rel - lambda_hat * V_rel.dot(lambda_hat)).norm();

        const double R_horiz_mag = std::max(
            std::sqrt(R_vec(0)*R_vec(0) + R_vec(1)*R_vec(1)), 0.1);
        const double los_el_deg  = std::atan2(R_vec(2), R_horiz_mag) * 180.0 / M_PI;

        // FIX-5: use TAS for FPA display, consistent with pitch controller
        const double tas_horiz = std::max(airspeed_, AIRSPEED_MIN);
        const double fpa_deg   = std::atan2(drone_vel_ned_(2), tas_horiz) * 180.0 / M_PI;

        RCLCPP_INFO_THROTTLE(this->get_logger(), *this->get_clock(), 1000,
            "[APN-FW] r=%.1fm tgo=%.2fs | Vc=%.1f Vtan=%.1f m/s | "
            "LOS_el=%.1f° FPA=%.1f° | roll=%.1f° pitch=%.1f° | IAS=%.1fm/s",
            R_mag, t_go, Vc, Vtan,
            los_el_deg, fpa_deg,
            att.roll  * 180.0 / M_PI,
            att.pitch * 180.0 / M_PI,
            airspeed_);
    }
};

// ═══════════════════════════════════════════════════════════════════════════
//  Entry point
// ═══════════════════════════════════════════════════════════════════════════
int main(int argc, char **argv)
{
    rclcpp::init(argc, argv);
    rclcpp::spin(std::make_shared<APNFixedWingStrikerNode>());
    rclcpp::shutdown();
    return 0;
}